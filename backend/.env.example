# 应用环境
APP_ENV=development
APP_DEBUG=false

# 服务器
HOST=0.0.0.0
PORT=8000

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=physics_lab
POSTGRES_SSLMODE=disable
# 单个后端进程最多使用 POOL_SIZE + MAX_OVERFLOW 个数据库连接。
# 多进程部署时应确保总连接数不超过 PostgreSQL max_connections 的安全预算。
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=128
REDIS_POOL_WAIT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_WARM_CONNECTIONS=32
STUDENT_CACHE_INITIAL_REFRESH_DELAY_SECONDS=3600
STUDENT_CACHE_PERIODIC_REFRESH_SECONDS=3600
STUDENT_DASHBOARD_CACHE_TTL_SECONDS=240
STUDENT_BITMAP_CACHE_TTL_SECONDS=300
STUDENT_AI_CONTEXT_CACHE_TTL_SECONDS=300
STUDENT_CACHE_TTL_JITTER_SECONDS=60
STUDENT_AI_MAX_CONCURRENCY=8
STUDENT_AI_ACQUIRE_TIMEOUT_SECONDS=2
SELECTION_QUEUE_MAX_LENGTH=20000
SELECTION_QUEUE_WORKER_COUNT=16
SELECTION_QUEUE_BATCH_SIZE=20
SELECTION_QUEUE_BLOCK_MS=1000
SELECTION_QUEUE_RESERVATION_SECONDS=900
SELECTION_REQUEST_STATUS_TTL_SECONDS=86400
SELECTION_CONTEXT_INITIAL_WARM_DELAY_SECONDS=3
SELECTION_CONTEXT_MISSING_SCAN_SECONDS=300
SELECTION_CONTEXT_WARM_CONCURRENCY=10
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT（开发环境可自定义，生产环境必须使用强随机密钥）
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI 模型
MODEL_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
HF_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=Qwen/Qwen3.5-4B:featherless-ai
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-14b
DASHSCOPE_ENABLE_THINKING=false

# LangSmith AI效果评测（真实密钥只写入.env）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=physics-lab-student-consultation
LANGSMITH_TRACING_SAMPLING_RATE=0.05
EVAL_JUDGE_PROVIDER=deepseek
EVAL_MAX_CONCURRENCY=4
EVAL_REPETITIONS=1
EVAL_STUDENT_NO=D2024010001

# 操作指南 Embedding（建议使用支持 BAAI/bge-m3 的 OpenAI 兼容接口）
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# 日志
LOG_LEVEL=INFO
LOG_JSON=false
LOG_DIR=logs

# 演示账号密码（仅用于 seed_demo_data.py）
DEMO_ACCOUNT_PASSWORD=Demo@123456
