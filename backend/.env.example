# =========================
# 应用基础配置
# =========================
APP_NAME=物理实验智能排课系统
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Shanghai
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# =========================
# PostgreSQL
# =========================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=physics_lab
POSTGRES_PASSWORD=physics_lab_dev_password
POSTGRES_DB=physics_lab
DATABASE_URL=postgresql+asyncpg://physics_lab:physics_lab_dev_password@127.0.0.1:5432/physics_lab
LANGGRAPH_DATABASE_URL=postgresql://physics_lab:physics_lab_dev_password@127.0.0.1:5432/physics_lab

# =========================
# Redis / Celery
# =========================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# =========================
# JWT
# =========================
# 请通过本地 .env 注入；生产环境必须使用安全的环境变量或密钥服务。
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# DeepSeek API
# =========================
# 请访问 https://platform.deepseek.com/ 获取 API Key。
# 不要把真实 Key 写入或提交到仓库。
DEEPSEEK_API_KEY=

# 按当前项目约定保留 /v1；如 SDK 出现兼容问题，可改为：
# https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=4096

# 默认使用 Mock Provider，填入 Key 后可切换为 deepseek。
MODEL_PROVIDER=mock

# =========================
# 日志
# =========================
LOG_LEVEL=INFO
LOG_JSON=false
LOG_DIR=logs
