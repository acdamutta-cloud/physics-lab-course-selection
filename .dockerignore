# 版本控制与配置
.git
.gitignore
.env
backend/.env

# Python
backend/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# 运行时产物与日志
backend/logs
backend/reports
backend/*.log
backend/*.err.log
backend/*.out.log

# 本地开发数据文件(不应进镜像)
backend/token.json
backend/token.txt
backend/test_export.xlsx
backend/courses.json
backend/detail.json
backend/plans.json
backend/task.json
backend/task2.json
backend/load-data

# 测试与评测(部署镜像不需要)
backend/tests
backend/evals

# 前端
frontend/node_modules
frontend/dist
frontend/logs
frontend/*.log

# 系统文件
*.md
Thumbs.db
.DS_Store
